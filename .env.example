APP_NAME="ERP Oficina"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Banco MySQL (crie o banco "erp_oficina" antes de rodar as migrations) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_oficina
DB_USERNAME=root
DB_PASSWORD=

# ---- SessÃ£o / login do front (cookie HttpOnly) ----
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Fila de jobs no prÃ³prio MySQL (processada por: php artisan queue:work) ----
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---- E-mail (em desenvolvimento, "log" grava os e-mails em storage/logs/laravel.log) ----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@oficina.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- WhatsApp Business Cloud API (deixe vazio para desativar) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_DOCUMENTO=
WHATSAPP_TEMPLATE_LEMBRETE=

# ---- Rotinas ----
BACKUP_HORARIO=02:00
BACKUP_MANTER=14
LEMBRETE_HORARIO=18:00
RELATORIOS_DIAS=7

# ---- Primeiro acesso (php artisan db:seed) ----
ADMIN_EMAIL=admin@oficina.local
ADMIN_PASSWORD=
